#!/bin/sh
# 报告对齐审查提醒（warn-only，不阻断提交）。
# 由 tools/reports/install-hook.sh 安装到 .git/hooks/pre-commit。
# 每个自然日第一次提交前跑一次，结果只打印；要跳过用 git commit --no-verify。

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
[ -x "$root/tools/reports/review.sh" ] || exit 0

stamp="$root/.git/reports-review.stamp"
today=$(TZ=Asia/Shanghai date +%F)
if [ -f "$stamp" ] && [ "$(cat "$stamp" 2>/dev/null)" = "$today" ]; then
	exit 0
fi
printf '%s\n' "$today" >"$stamp"

out=$("$root/tools/reports/review.sh" --quiet 2>&1)
rc=$?

if [ -n "$out" ]; then
	printf '\n%s\n' "$out"
fi
if [ "$rc" -ne 0 ]; then
	printf '提示：报告与昨天【不】一致，请先确认再提交；跳过用 git commit --no-verify。\n\n'
else
	printf '\n'
fi
exit 0
